{
  "schemaVersion": 1,
  "id": "infracraft",
  "version": "${version}",
  "name": "InfraCraft",
  "description": "Romantic transport infrastructure: no elytra, 1:1 Nether, no teleporting. See the world by road, rail, subway, harbor and horse.",
  "authors": ["menonng"],
  "contact": { "sources": "https://github.com/menonng/InfraCraft" },
  "license": "All-Rights-Reserved",
  "icon": "assets/infracraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{ "adapter": "kotlin", "value": "dev.menonng.infracraft.InfraCraft" }],
    "client": [{ "adapter": "kotlin", "value": "dev.menonng.infracraft.client.InfraCraftClient" }]
  },
  "mixins": ["infracraft.mixins.json"],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${flk_version}"
  },
  "suggests": { "couriersroost": "*" }
}
